# --- Zorunlu ---

# LiveKit (cloud konsolundan: Settings > Keys)
LIVEKIT_URL=wss://<proje>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# LLM — varsayılan yığın OpenAI kullanıyor
OPENAI_API_KEY=

# STT — varsayılan yığın Deepgram nova-3 kullanıyor
DEEPGRAM_API_KEY=

# TTS — varsayılan yığın ElevenLabs kullanıyor.
# DİKKAT: plugin bu ismi okuyor, ELEVENLABS_API_KEY değil.
ELEVEN_API_KEY=

# --- Opsiyonel (config.yaml'da o sağlayıcıya geçersen gerekir) ---

# provider: cartesia  (TTS alternatifi)
CARTESIA_API_KEY=

# provider: anthropic (LLM alternatifi)
# Önce paketi ekle: uv add livekit-plugins-anthropic
ANTHROPIC_API_KEY=
